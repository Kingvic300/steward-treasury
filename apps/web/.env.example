# All optional. Defaults come from deployments/testnet.json.

# Override the Soroban RPC endpoint (for example a private provider).
NEXT_PUBLIC_RPC_URL=

# Mainnet stays disabled until the contract is audited. Leave this off.
NEXT_PUBLIC_ENABLE_MAINNET=false

# Test wallet for Playwright: signs with a secret key read from localStorage.
# NEVER enable this in a production deployment.
NEXT_PUBLIC_ENABLE_TEST_WALLET=false
